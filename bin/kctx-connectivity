#!/usr/bin/env bash
set -euo pipefail

# Background Kubernetes API checks with optional, locally configured repair.
cache_dir="${KCTX_STATUS_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/kctx}"
hook="${KCTX_CONNECT_HOOK:-${XDG_CONFIG_HOME:-$HOME/.config}/kctx/connect-hook}"
context=""
state_file=""
umask 077

select_context() {
  context="${1:-$(kubectl config current-context 2>/dev/null)}"
  [[ -n "$context" ]] || return 1
  local key
  key=$(printf '%s' "$context" | od -An -tx1 | tr -d ' \n')
  state_file="$cache_dir/context-$key"
}

write_state() {
  mkdir -p "$cache_dir"
  local tmp
  tmp=$(mktemp "$state_file.XXXXXX")
  printf '%s %s\n' "$1" "$(date +%s)" > "$tmp"
  mv -f "$tmp" "$state_file"
}

api_ready() {
  kubectl --context "$context" --request-timeout=5s get --raw=/readyz &>/dev/null
}

probe() {
  write_state checking || true
  if api_ready; then
    write_state up
  else
    write_state down
  fi
}

ensure_locked() {
  if api_ready; then
    write_state up
    return 0
  fi

  if [[ ! -x "$hook" ]] || ! "$hook" "$context" restart &>/dev/null; then
    write_state down
    return 1
  fi

  local attempt
  for attempt in 1 2 3 4 5; do
    if api_ready; then
      write_state up
      return 0
    fi
    if (( attempt < 5 )); then
      sleep 2
    fi
  done

  write_state down
  return 1
}

ensure() {
  mkdir -p "$cache_dir"
  local lock_file="$state_file.ensure.lock" result=0

  # Kernel locks are released if a checker exits unexpectedly. A concurrent
  # selection can rely on the active checker to publish the final state.
  if command -v lockf >/dev/null 2>&1; then
    lockf -k -t 0 "$lock_file" "$0" ensure-locked "$context" 2>/dev/null || result=$?
  elif command -v flock >/dev/null 2>&1; then
    flock -E 75 -n "$lock_file" "$0" ensure-locked "$context" 2>/dev/null || result=$?
  else
    write_state down
    printf 'kctx-connectivity: lockf or flock is required\n' >&2
    return 1
  fi

  if (( result == 75 )); then
    return 0
  fi
  return "$result"
}

connect() {
  write_state checking || true
  nohup "$0" ensure "$context" </dev/null >/dev/null 2>&1 &
}

status() {
  local namespace="" state=checking checked_at=0 now interval=30 symbol
  select_context || return 0
  namespace=$(kubectl config view --minify -o jsonpath='{.contexts[0].context.namespace}' 2>/dev/null) || true

  if [[ -r "$state_file" ]]; then
    read -r state checked_at < "$state_file" || true
  fi
  [[ "$checked_at" =~ ^[0-9]+$ ]] || checked_at=0
  case "$state" in
    up|down|checking) ;;
    *) state=checking ;;
  esac

  now=$(date +%s)
  [[ "$state" == checking ]] && interval=90
  if (( now - checked_at >= interval )); then
    state=checking
    write_state checking 2>/dev/null || true
    nohup "$0" ensure "$context" </dev/null >/dev/null 2>&1 &
  fi
  case "$state" in
    up) symbol=◆ ;;
    down) symbol=◇ ;;
    checking) symbol=◈ ;;
  esac
  printf '%s%s\n' "$symbol" "$namespace"
}

case "${1:-}" in
  connect) select_context "${2:-}" || exit 0; connect ;;
  ensure) select_context "${2:-}"; ensure ;;
  ensure-locked) select_context "${2:-}"; ensure_locked ;;
  probe) select_context "${2:-}"; probe ;;
  status) status ;;
  *) printf 'usage: %s <connect|ensure|probe|status> [context]\n' "$0" >&2; exit 2 ;;
esac
